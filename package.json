{
  "name": "agentadmit-mcp-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "A database MCP server protected by AgentAdmit: user-granted scopes, confirm-each-time on destructive tools, decline, revoke.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agentadmit-mcp-showcase": "src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "seed": "node scripts/seed-db.mjs",
    "register-scopes": "node scripts/register-scopes.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentadmit/sdk": "1.13.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
